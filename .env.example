# Ключ доступа сообщества (Управление → Дополнительно → Работа с API → Ключи доступа), права messages и manage
VK_TOKEN=
# ID сообщества, число без минуса
VK_GROUP_ID=
# Твой VK id, число. Только сообщения с этого id доходят до агентов
VK_OWNER_ID=
# 1 = работать без ВК, через локальную заглушку (для проверки)
VK_STUB=0
# Порт хаба на 127.0.0.1
HUB_PORT=8765
